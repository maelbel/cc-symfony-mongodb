{% extends 'layouts/public.html.twig' %}

{% block main %}
  <div class="py-8 px-4">
    <div class="grid grid-cols-1 gap-6">
      <aside>
        {% include 'components/customer_nav.html.twig' %}
      </aside>

      <main>
        <div class="mb-4 flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-semibold text-slate-800">{% block page_title %}Customer Area{% endblock %}</h1>
            <nav class="text-sm text-slate-500 mt-1">{% block breadcrumbs %}{% endblock %}</nav>
          </div>
          <div>
            {% block page_actions %}{% endblock %}
          </div>
        </div>

        {% block customer_content %}{% endblock %}
      </main>
    </div>
  </div>
{% endblock %}
