{% extends 'base.html.twig' %}
{% block body %}
<div class="container mt-5">
  <h2>Welcome {{ customer.username }}</h2>
  <h3>My Bookings</h3>
  
  {% if reservations|length > 0 %}
    <div class="row">
      {% for reservation in reservations %}
        <div class="col-md-6 mb-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ reservation.hotel.hotelName }}</h5>
              <p class="card-text">
                <strong>Room:</strong> {{ reservation.room.codeChambre ?? 'Not specified' }}<br>
                <strong>Dates:</strong> {{ reservation.startDate|date('d/m/Y') }} to {{ reservation.endDate|date('d/m/Y') }}
              </p>
              
              {% if reservation.note %}
                <div class="alert alert-info mt-3">
                  <strong>Note:</strong> {{ reservation.note }}
                </div>
              {% endif %}
              
              <div class="mt-3">
                <!-- Add Note Button -->
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#noteModal{{ reservation.reservationCode }}">
                  Add/Edit Note
                </button>
                
                <!-- Cancel Button -->
                <a href="{{ path('customer_reservation_confirm_cancel', {id: reservation.reservationCode}) }}" class="btn btn-sm btn-danger">
                  Cancel Booking
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Modal for Adding Note -->
        <div class="modal fade" id="noteModal{{ reservation.reservationCode }}" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Add Note to Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <form method="POST" action="{{ path('customer_reservation_add_note', {id: reservation.reservationCode}) }}">
                <div class="modal-body">
                  <div class="mb-3">
                    <label for="note" class="form-label">Note</label>
                    <textarea class="form-control" id="note" name="note" rows="4">{{ reservation.note }}</textarea>
           </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Save Note</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="alert alert-info">
      No bookings found. <a href="{{ path('home') }}">Browse hotels</a>
    </div>
  {% endif %}
</div>

{% endblock %}