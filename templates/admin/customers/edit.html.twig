{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Edit Customer - My Hotel{% endblock %}

{% block dashboard_content %}
  <div class="mb-6 flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-bold text-sky-700">Edit Customer</h1>
      <p class="text-sm text-slate-500">Update customer details below.</p>
      {% if customer is defined %}
        <div class="mt-2 text-sm text-slate-600">
          <span class="font-medium">ID:</span>
          <span class="inline-block bg-slate-100 text-slate-800 px-2 py-0.5 rounded ml-2">{{ customer.customerCode }}</span>
        </div>
        <div class="mt-2">
          {% for r in customer.getRoles() %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800 mr-2">{{ r }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="flex items-center gap-3">
      <a href="{{ path('admin_customers') }}" class="text-slate-600 hover:underline">Back to list</a>
    </div>
  </div>

  <div class="bg-white rounded shadow p-6">
    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {{ form_row(form.username, {attr: {class: 'block w-full border border-slate-200 rounded px-3 py-2 focus:outline-none focus:ring-1 focus:ring-sky-500'}}) }}
        {{ form_row(form.email, {attr: {class: 'block w-full border border-slate-200 rounded px-3 py-2 focus:outline-none focus:ring-1 focus:ring-sky-500'}}) }}
        {{ form_row(form.address, {attr: {class: 'block w-full border border-slate-200 rounded px-3 py-2'}}) }}
        {{ form_row(form.phone, {attr: {class: 'block w-full border border-slate-200 rounded px-3 py-2'}}) }}
      </div>

      {% if form.password is defined %}
        <div>
          {{ form_row(form.password, {help: 'Leave blank to keep the current password', attr: {class: 'block w-full border border-slate-200 rounded px-3 py-2'}}) }}
        </div>
      {% endif %}

      {% if form.roles is defined %}
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2">Roles</label>
        <div class="flex flex-wrap gap-3">
          {% for roleField in form.roles %}
            <label class="inline-flex items-center gap-2 bg-slate-50 border border-slate-100 rounded px-3 py-2 text-sm">
              {{ form_widget(roleField, {attr: {class: 'h-4 w-4 text-sky-600'}}) }}
              <span class="text-slate-700">{{ roleField.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="{{ path('admin_customers') }}" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded hover:bg-slate-50">Cancel</a>
        <button type="submit" class="px-4 py-2 bg-sky-600 text-white rounded hover:bg-sky-700">Save changes</button>
      </div>

    {{ form_end(form) }}
  </div>
{% endblock %}
