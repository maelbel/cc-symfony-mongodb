{% extends 'layouts/dashboard.html.twig' %}

{% block title %}View Customer - My Hotel{% endblock %}

{% block dashboard_content %}
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-sky-700">View Customer</h1>
    <p class="text-sm text-slate-500">Details for customer {{ customer.getCustomerCode() }}</p>
  </div>

  <div class="bg-white rounded shadow p-6">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">ID</dt>
        <dd class="mt-1 text-sm text-slate-700">{{ customer.getCustomerCode() }}</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Username</dt>
        <dd class="mt-1 text-sm text-slate-700">{{ customer.getUsername() }}</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-700">{{ customer.getEmail() }}</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Phone</dt>
        <dd class="mt-1 text-sm text-slate-700">{{ customer.getPhone() }}</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Address</dt>
        <dd class="mt-1 text-sm text-slate-700">{{ customer.getAddress() }}</dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Roles</dt>
        <dd class="mt-1 text-sm text-slate-700">
          {% for role in customer.getRoles() %}
            <span class="inline-block px-2 py-1 mr-1 text-xs font-medium rounded {{ role=='ROLE_ADMIN' ? 'bg-yellow-100 text-yellow-800' : 'bg-slate-100 text-slate-800' }}">{{ role }}</span>
          {% endfor %}
        </dd>
      </div>
    </dl>

    <div class="mt-6">
      <a href="{{ path('admin_customers_edit', {'codeCustomer': customer.getCustomerCode()}) }}" class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">Edit</a>
      <form method="post" action="{{ path('admin_customers_delete', {'codeCustomer': customer.getCustomerCode()}) }}" style="display:inline;" onsubmit="return confirm('Are you sure?');">
        <button type="submit" class="ml-3 px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
      </form>
      <a href="{{ path('admin_customers') }}" class="ml-3 text-slate-600 hover:underline">Back</a>
    </div>
  </div>
{% endblock %}
