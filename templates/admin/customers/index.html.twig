{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ title }} - My Hotel{% endblock %}

{% block dashboard_content %}
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-sky-700">{% block dashboard_title %}{{ title }}{% endblock %}</h1>
    <p class="text-sm text-slate-500">{% block dashboard_subtitle %}Manage customers and their details here.{% endblock %}</p>
  </div>

    <div class="mb-4 flex justify-between items-center">
    <form method="get" class="flex gap-2">
      <input type="text" name="name" value="{{ filters.name|default('') }}" placeholder="Name" class="border border-slate-300 rounded px-3 py-2">
      <input type="text" name="email" value="{{ filters.email|default('') }}" placeholder="Email" class="border border-slate-300 rounded px-3 py-2">
      <button type="submit" class="px-4 py-2 bg-sky-600 text-white rounded hover:bg-sky-700">Filter</button>
    </form>
    <a href="{{ path('app_register') }}" class="px-4 py-2 bg-sky-600 text-white rounded hover:bg-sky-700">Add Customer</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="mb-4 p-3 rounded-md bg-green-50 border border-green-200 text-green-800">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="mb-4 p-3 rounded-md bg-red-50 border border-red-200 text-red-800">{{ message }}</div>
  {% endfor %}

  <div class="bg-white rounded shadow p-6">
    <table class="min-w-full divide-y divide-slate-200">
      <thead>
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-slate-500">ID</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-slate-500">Name</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-slate-500">Email</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-slate-500">Roles</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for customer in customers %}
          <tr class="border-b">
            <td class="px-4 py-2">{{ customer.customerCode }}</td>
            <td class="px-4 py-2">{{ customer.username|default('—') }}</td>
            <td class="px-4 py-2">{{ customer.email|default('—') }}</td>
            <td class="px-4 py-2">
              {% for role in customer.roles %}
                <span class="inline-block px-2 py-1 mr-1 text-xs font-medium rounded {{ role=='ROLE_ADMIN' ? 'bg-yellow-100 text-yellow-800' : 'bg-slate-100 text-slate-800' }}">{{ role }}</span>
              {% else %}
                <span class="text-slate-500">—</span>
              {% endfor %}
            </td>
            <td class="px-4 py-2">
              <a href="{{ path('admin_customers_view', {'codeCustomer': customer.customerCode}) }}" class="text-sky-600 hover:underline">View</a>
              <a href="{{ path('admin_customers_edit', {'codeCustomer': customer.customerCode}) }}" class="ml-2 text-yellow-600 hover:underline">Edit</a>
              <form method="post" action="{{ path('admin_customers_delete', {'codeCustomer': customer.customerCode}) }}" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                <button type="submit" class="ml-2 text-red-600 hover:underline bg-transparent border-none cursor-pointer">Delete</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="px-4 py-2 text-center text-slate-500">No customers found.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    {% if pagination is defined %}
      <div class="mt-4 flex justify-center">
        {{ knp_pagination_render(pagination) }}
      </div>
    {% endif %}
  </div>
{% endblock %}
