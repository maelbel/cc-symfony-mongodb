{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ title }} - My Hotel{% endblock %}

{% block dashboard_content %}
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-sky-700">Edit Booking #{{ booking.reservationCode }}</h1>
    <p class="text-sm text-slate-500">Modify reservation details below.</p>
  </div>

  <div class="bg-white/80 backdrop-blur rounded-lg shadow p-4">
    {{ form_start(form) }}
      <div class="grid grid-cols-1 gap-4">
        {{ form_row(form.hotel) }}
        {{ form_row(form.room) }}
        {{ form_row(form.startDate) }}
        {{ form_row(form.endDate) }}
        {{ form_row(form.note) }}
      </div>

      <div class="mt-4 flex gap-2">
        <button type="submit" class="px-3 py-2 bg-sky-600 text-white rounded text-sm hover:bg-sky-700">Save</button>
        <a href="{{ path('admin_bookings_show', {id: booking.reservationCode}) }}" class="px-3 py-2 bg-white border border-slate-200 text-slate-700 rounded hover:bg-slate-50">Cancel</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
