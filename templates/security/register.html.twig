{% extends 'layouts/public.html.twig' %}

{% block title %}Register{% endblock %}

{% block main %}
    <div class="min-h-[70vh] flex items-center justify-center">
        <div class="w-full max-w-lg bg-white/80 backdrop-blur rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-semibold text-slate-800 mb-4">Create your account</h1>

            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

                <div>
                    {{ form_label(form.username, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-400'}}) }}
                    {{ form_errors(form.username) }}
                </div>

                <div>
                    {{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                    {{ form_widget(form.address, {'attr': {'class': 'w-full rounded-md border border-slate-200 px-3 py-2'}}) }}
                    {{ form_errors(form.address) }}
                </div>

                <div>
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                    {{ form_widget(form.phone, {'attr': {'class': 'w-full rounded-md border border-slate-200 px-3 py-2'}}) }}
                    {{ form_errors(form.phone) }}
                </div>

                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-md border border-slate-200 px-3 py-2'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div>
                    {{ form_label(form.password, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                    {{ form_widget(form.password, {'attr': {'class': 'w-full rounded-md border border-slate-200 px-3 py-2'}}) }}
                    {{ form_errors(form.password) }}
                </div>

                <div class="mt-4 text-sm text-slate-700">
                    <p>Already have an account? <a href="{{ path('app_login') }}" class="text-sky-600 hover:underline">Login here</a></p>
                </div>

                <div class="flex items-center justify-end">
                    <button type="submit" class="px-4 py-2 rounded-md text-sm font-medium bg-sky-600 text-white hover:bg-sky-700">Register</button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>
{% endblock %}