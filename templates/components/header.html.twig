<header class="bg-white/60 backdrop-blur sticky top-0 z-30">
  <div class="max-w-7xl mx-auto py-4 flex items-center justify-between">
    {# Brand #}
    <a href="{{ path('home') }}" class="text-2xl font-bold text-sky-700">My Hotel</a>

    {# Actions: admin dashboard, profile/login/register, logout #}
    <div class="flex items-center space-x-6">
      <div class="flex items-center space-x-3" role="navigation" aria-label="Header actions">

        {# Admin only: Dashboard link #}
        {% if is_granted('ROLE_ADMIN') %}
          <a
            href="{{ path('admin_dashboard') }}"
            class="px-4 py-2 rounded-md text-sm font-medium border border-sky-600 text-sky-600 hover:bg-sky-50"
          >
            Dashboard
          </a>
        {% endif %}

        {# If logged in show username and logout form #}
        {% if app.user %}
          <a
            href="{{ path('customer_profile') }}"
            class="px-4 py-2 cursor-pointer rounded-md text-sm font-medium text-slate-700 hover:bg-slate-100"
          >
            {{ app.user.username }}
          </a>

          <form method="post" action="{{ path('app_logout') }}" class="inline" aria-label="Logout form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button
              type="submit"
              class="px-4 py-2 cursor-pointer rounded-md text-sm font-medium bg-red-600 text-white hover:bg-red-700"
            >
              Logout
            </button>
          </form>

        {# Guest: show register and login links #}
        {% else %}
          <a
            href="{{ path('app_register') }}"
            class="px-4 py-2 rounded-md text-sm font-medium border border-sky-600 text-sky-600 hover:bg-sky-50"
          >
            Register
          </a>

          <a
            href="{{ path('app_login') }}"
            class="px-4 py-2 rounded-md text-sm font-medium bg-sky-600 text-white hover:bg-sky-700"
          >
            Login
          </a>
        {% endif %}

      </div>
    </div>
  </div>
</header>
